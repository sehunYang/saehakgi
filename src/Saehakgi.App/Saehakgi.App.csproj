<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Saehakgi.App</RootNamespace>
    <AssemblyName>saehakgi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Single-file, self-contained publish so it runs from a USB with no install.
         Build:   dotnet build
         Publish: dotnet publish -c Release -r win-x64 -->
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(PublishSingleFile)' == 'true'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Saehakgi.Core\Saehakgi.Core.csproj" />
  </ItemGroup>

</Project>
