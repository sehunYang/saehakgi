    <Nullable>enable</Nullable>
    <RootNamespace>Saehakgi.Core</RootNamespace>
    <AssemblyName>Saehakgi.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
